{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Canopy",
  "version": "0.1.0",
  "identifier": "dev.canopy.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Canopy",
        "width": 1400,
        "height": 880,
        "minWidth": 980,
        "minHeight": 620,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0d1014"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
